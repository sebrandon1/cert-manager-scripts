{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "avg by (exported_namespace, name) (certmanager_certificate_expiration_timestamp_seconds - time())",
          "legendFormat": "{{exported_namespace}}/{{name}}",
          "refId": "A"
        }
      ],
      "title": "Certificate time until expiry",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "max by (exported_namespace, name, condition) (certmanager_certificate_ready_status)",
          "legendFormat": "{{exported_namespace}}/{{name}} ({{condition}})",
          "refId": "A"
        }
      ],
      "title": "Certificate ready status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (host, status) (rate(certmanager_http_acme_client_request_count[5m]))",
          "legendFormat": "{{host}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "ACME client request rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "up{job=\"cert-manager\"}",
          "legendFormat": "cert-manager",
          "refId": "A"
        }
      ],
      "title": "cert-manager scrape up",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["cert-manager"],
  "templating": {
    "list": [
      {
        "current": {},
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "cert-manager",
  "uid": "cert-manager-scripts",
  "version": 1
}
